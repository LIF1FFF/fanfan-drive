# 在 EdgeOne Pages 控制台 → 项目设置 → 环境变量 中逐项添加。
# 不要把真实密钥写进文件并提交到 GitHub。

QINIU_AK=
QINIU_SK=
QINIU_BUCKET=
QINIU_DOMAIN=https://your-cdn-domain.com
QINIU_REGION=z0
QINIU_PRIVATE=1
# PAN_PASSWORD：后台 /admin 的管理密码。主页面访客可免密浏览与下载，
# 只有上传 / 删除 / 重命名 / 建目录等写操作需要在后台输入此密码解锁。
PAN_PASSWORD=
MAX_UPLOAD_MB=200

# QINIU_DOMAIN 必须是「空间详情 → 域名管理」里的绑定域名，且带 https://。
# 系统赠送的测试域名只有 30 天有效期，正式对外使用请绑定已备案的自有域名，
# 并按控制台给出的 CNAME 值到 DNS 添加解析、开通 HTTPS 证书。
# 创建空间时访问控制务必选「私有」，与 QINIU_PRIVATE=1 保持一致。
#
# 区域对照：z0 华东-浙江 / z1 华北-河北 / z2 华南-广东 / na0 北美 / as0 新加坡
# 区域必须与空间所在区域一致，否则列举文件会报 612。
# QINIU_PRIVATE=1 表示私有空间（推荐）；设为 0 表示公开空间。
# 若使用了特殊区域域名，可额外覆盖：
# QINIU_UPLOAD_HOST=
# QINIU_RS_HOST=
# QINIU_RSF_HOST=
